# Database
# These values describe the application database connection used at runtime.
# Replace every placeholder in a real .env file; this example is safe to copy,
# but it is not intended to contain production credentials.
DATABASE_URL=postgresql+asyncpg://pulseops:change-me@db:5432/pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulseops

# Azure Storage / Azurite
# Azurite provides a local Azure Storage-compatible endpoint; production deployments
# should use the connection string issued for the target Azure Storage account.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# ClickUp
# The token authenticates API calls, while the team and list IDs select the
# destination for synchronized student records.
CLICKUP_API_TOKEN=your_token_here
CLICKUP_TEAM_ID=your_team_id_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here

# Webhook verification
# Shared secrets let webhook handlers reject requests that cannot prove they were
# sent by the configured integration. Generate distinct, high-entropy values.
GHL_WEBHOOK_SECRET=replace-with-a-random-secret
CLICKUP_WEBHOOK_SECRET=replace-with-a-random-secret
