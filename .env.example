# Database
DATABASE_URL=postgresql+asyncpg://pulseops:change-me@db:5432/pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulseops

# Azure Storage / Azurite
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# ClickUp
CLICKUP_API_TOKEN=your_token_here
CLICKUP_TEAM_ID=your_team_id_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here

# Webhook verification
GHL_WEBHOOK_SECRET=replace-with-a-random-secret
CLICKUP_WEBHOOK_SECRET=replace-with-a-random-secret
